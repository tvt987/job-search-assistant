{%- macro sechead(icon, title) -%}
<div class="sh"><span class="ic">{{ I[icon] | safe }}</span><h2>{{ title }}</h2><span class="ln"></span></div>
{%- endmacro -%}

{%- macro bullets(items) -%}
<ul class="bul">{% for b in items %}<li>{{ b }}</li>{% endfor %}</ul>
{%- endmacro -%}

{%- macro section(sec) -%}
{%- set key = sec.section -%}
{%- if key == 'summary' -%}
<section>
  {{ sechead('user', 'Professional Summary') }}
  <p class="summary">{{ cv.summary }}</p>
</section>
{%- elif key == 'highlights' -%}
<section>
  {{ sechead('spark', 'Highlights') }}
  <div class="stats">
    {% for h in cv.highlights %}<div class="stat"><b>{{ h.value }}</b><span>{{ h.label }}</span></div>{% endfor %}
  </div>
</section>
{%- elif key == 'facts' -%}
<section>
  <div class="facts">
    {% for f in cv.facts %}<div class="fact"><b>{{ f.value }}</b><span>{{ f.label }}</span></div>{% endfor %}
  </div>
</section>
{%- elif key == 'experience' -%}
<section>
  {{ sechead('case', 'Work Experience (continued)' if sec.continued else 'Work Experience') }}
  {% for j in cv.experience[sec.skip : sec.skip + sec.take] %}
  <div class="job">
    <span class="node"></span>
    <div class="job-top">
      <div class="job-title">{{ j.role }} <i>at</i> <em>{{ j.company }}</em></div>
      <span class="period">{{ j.period }}</span>
    </div>
    {% if j.get('note') %}<div class="job-note">{{ j.note }}</div>{% endif %}
    {{ bullets(j.bullets) }}
  </div>
  {% endfor %}
</section>
{%- elif key == 'projects' -%}
<section>
  {{ sechead('folder', 'Projects (continued)' if sec.continued else 'Projects') }}
  {% for p in cv.projects[sec.skip : sec.skip + sec.take] %}
  <div class="proj">
    <div class="proj-top">
      <div class="proj-head">
        <span class="proj-name">{{ p.name }}</span>
        <span class="proj-role">{{ p.role }}</span>
        <span class="proj-stack">{{ p.stack }}</span>
      </div>
      {% if p.get('link') %}<a class="link" href="https://{{ p.link }}">{{ I['link'] | safe }}{{ p.link }}</a>{% endif %}
    </div>
    {{ bullets(p.bullets) }}
  </div>
  {% endfor %}
</section>
{%- elif key == 'skills' -%}
<section>
  {{ sechead('layers', 'Skills and Technologies') }}
  <div class="skill-table">
    {% for g in cv.skills %}
    <div class="skill-row">
      <div class="skill-label">{{ g.label }}</div>
      <div class="chips">{% for s in g['items'] %}<span class="chip{% if g.get('primary') %} pri{% endif %}">{{ s }}</span>{% endfor %}</div>
    </div>
    {% endfor %}
  </div>
</section>
{%- elif key == 'footerinfo' -%}
<section>
  <div class="cards">
    <div class="card">
      <div class="ct">{{ I['cap'] | safe }}<h3>Education</h3></div>
      <div class="main">{{ me.education.school }}</div>
      <div class="sub">{{ me.education.degree }} &middot; {{ me.education.detail }}</div>
    </div>
    <div class="card">
      <div class="ct">{{ I['globe'] | safe }}<h3>Languages</h3></div>
      {% for l in me.languages %}<div class="lang"><b>{{ l.name }}</b><span>{{ l.level }}</span></div>{% endfor %}
    </div>
  </div>
</section>
{%- endif -%}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ me.name }} — {{ cv.role }}</title>
<style>{{ css | safe }}</style>
</head>
<body class="theme-{{ cv.theme }} den-{{ cv.get('density', 'compact') }}{% if cv.pages | length == 1 %} one-page{% endif %}">
{% for page in cv.pages %}
<div class="sheet">
  <div class="deco-arc"></div>
  <div class="deco-dots"></div>

  {% if loop.first %}
  <div class="band-top"></div>
  <header class="band">
    <div class="band-inner">
      <div class="identity">
        <div class="name">{{ me.name }}</div>
        <div class="role-line"><span class="sep"></span><span class="role">{{ cv.role }}</span></div>
        <div class="tagline">{{ cv.tagline }}</div>
        <div class="contacts">
          <a class="contact" href="tel:{{ me.phone | replace(' ', '') }}">{{ I['phone'] | safe }}{{ me.phone }}</a>
          <a class="contact" href="mailto:{{ me.email }}">{{ I['mail'] | safe }}{{ me.email }}</a>
          <span class="contact">{{ I['pin'] | safe }}{{ me.location }}</span>
          <a class="contact" href="{{ me.github_url }}">{{ I['github'] | safe }}{{ me.github }}</a>
          <a class="contact" href="{{ me.linkedin_url | urlquote }}">{{ I['linkedin'] | safe }}{{ me.linkedin }}</a>
        </div>
      </div>
      <div class="photo-ring"><img src="{{ photo }}" alt="{{ me.name }}"></div>
    </div>
  </header>
  {% else %}
  <div class="minihead">
    <div class="row">
      <div class="mh-name">{{ me.name }}</div>
      <div class="mh-role"><b>{{ cv.role }}</b> &middot; {{ me.email }} &middot; {{ me.phone }}</div>
    </div>
    <div class="mh-rule"></div>
  </div>
  {% endif %}

  <div class="body">
    {% for sec in page %}{{ section(sec) }}{% endfor %}
  </div>

  <div class="foot">
    <span><b>{{ me.name }}</b> &middot; {{ cv.role }} &middot; {{ me.github }}</span>
    {% if cv.pages | length > 1 %}
    <span class="pg"><i>{{ loop.index }}</i> of {{ cv.pages | length }}</span>
    {% else %}
    <span>{{ me.availability }}</span>
    {% endif %}
  </div>
</div>
{% endfor %}
<script>
/* Build-time fit check only (ignored by the PDF): reports the gap in px
   between the last block of every sheet and that sheet's footer rule. */
window.addEventListener('load', function () {
  var out = [];
  document.querySelectorAll('.sheet').forEach(function (sh, i) {
    var body = sh.querySelector('.body'), foot = sh.querySelector('.foot');
    var last = body.lastElementChild;
    out.push((i + 1) + ':' + Math.round(foot.getBoundingClientRect().top - last.getBoundingClientRect().bottom));
    var parts = [];
    body.querySelectorAll(':scope > section').forEach(function (sec) {
      var h2 = sec.querySelector('h2');
      parts.push((h2 ? h2.textContent.trim().split(' ')[0] : sec.firstElementChild.className) +
                 '=' + (sec.getBoundingClientRect().height / 96 * 25.4).toFixed(0));
    });
    var band = sh.querySelector('.band') || sh.querySelector('.minihead');
    parts.unshift('HEADER=' + (band.getBoundingClientRect().height / 96 * 25.4).toFixed(0));
    sh.setAttribute('data-sections', parts.join(' '));
  });
  document.documentElement.setAttribute('data-fit', out.join(','));
});
</script>
</body>
</html>
