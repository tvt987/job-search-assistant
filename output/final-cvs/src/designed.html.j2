{#- Designed (one-page) layout. Same content as template.html.j2 (ATS version).
    ATS rule: no positioned element may contain text. Chromium paints positioned
    boxes after normal flow, which reorders text in the PDF content stream. -#}
{%- macro sechead(icon, title) -%}
<div class="sh"><span class="ic">{{ I[icon] | safe }}</span><h2>{{ title }}</h2><span class="ln"></span></div>
{%- endmacro -%}
{%- macro bullets(items) -%}
<ul class="bul">{% for b in items %}<li>{{ b }}</li>{% endfor %}</ul>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ me.name }} - {{ cv.title }} CV</title>
<style>{{ css | safe }}</style>
</head>
<body class="theme-{{ cv.theme }}">
<div class="sheet">
  <div class="band-top"></div>
  <header class="band">
    <div class="identity">
      <h1 class="name">{{ me.name }}</h1>
      <div class="role-line"><span class="sep"></span><span class="role">{{ cv.title }}</span><span class="sub">| {{ cv.subtitle }}</span></div>
      <div class="tagline">{{ cv.stack }}</div>
      <div class="contacts">
        <a class="contact" href="tel:{{ me.phone | replace(' ', '') }}">{{ I['phone'] | safe }}{{ me.phone }}</a>
        <a class="contact" href="mailto:{{ me.email }}">{{ I['mail'] | safe }}{{ me.email }}</a>
        <span class="contact">{{ I['pin'] | safe }}{{ me.location }} ({{ me.work_mode }})</span>
        <span class="brk"></span>
        <a class="contact" href="{{ me.github_url }}">{{ I['github'] | safe }}{{ me.github }}</a>
        <a class="contact" href="{{ me.linkedin_url | urlquote }}">{{ I['linkedin'] | safe }}{{ me.linkedin }}</a>
      </div>
    </div>
    <div class="photo-ring"><img src="{{ photo }}" alt="Photo of {{ me.name }}"></div>
  </header>

  <div class="body">
    <section>
      {{ sechead('user', 'Professional Summary') }}
      <p class="summary">{{ cv.summary }}</p>
    </section>

    <section>
      {{ sechead('case', 'Work Experience') }}
      {% for j in cv.experience %}
      <div class="job">
        <div class="job-top">
          <div class="job-title">{{ j.role }} <i>at</i> <em>{{ j.company }}</em></div>
          <span class="period">{{ j.period }}</span>
        </div>
        {% if j.get('stack') %}<div class="job-note">{% if j.get('context') %}<span class="ctx">{{ me.con_cung_context }}</span> · {% endif %}{{ j.stack | replace(', ', ' · ') }}</div>{% endif %}
        {{ bullets(j.bullets) }}
      </div>
      {% endfor %}
    </section>

    <section>
      {{ sechead('folder', 'Projects') }}
      {% for p in cv.projects %}{% set ref = me.project_catalogue[p.key] %}
      <div class="proj">
        <div class="proj-top">
          <div class="proj-head">
            <span class="proj-name">{{ ref.name }}</span>
            <span class="proj-role">{{ p.role }}</span>
            <span class="proj-stack">{{ p.stack }}</span>
          </div>
          {% if ref.get('link') %}<a class="link" href="https://{{ ref.link }}">{{ I['link'] | safe }}{{ ref.link }}</a>{% endif %}
        </div>
        {{ bullets(p.bullets) }}
      </div>
      {% endfor %}
      <p class="other"><b>Other projects:</b>
      {% for o in cv.other_projects %}{% set key = o if o is string else o.key %}{% set ref = me.project_catalogue[key] %}{% if ref.get('link') %}<a href="https://{{ ref.link }}">{{ ref.name }}</a>{% else %}{{ ref.name }}{% endif %} ({{ ref.short if o is string else o.text }}){{ '; ' if not loop.last else '.' }}{% endfor %}
      </p>
    </section>

    <section>
      {{ sechead('layers', 'Skills and Technologies') }}
      <div class="skill-table">
        {% for g in cv.skills %}
        <div class="skill-row"><div class="skill-label">{{ g.label }}</div><div class="skill-items">{{ g['items'] | join(', ') }}</div></div>
        {% endfor %}
      </div>
    </section>

    <section>
      <div class="cards">
        <div class="card"><div class="ct">{{ I['cap'] | safe }}<h3>Education</h3></div>
          <div class="val"><b>{{ me.education.school }}</b> · {{ me.education.degree }} · {{ me.education.period }}</div></div>
        <div class="card"><div class="ct">{{ I['globe'] | safe }}<h3>Languages</h3></div>
          <div class="val">{% for l in me.languages %}<b>{{ l.name }}:</b> {{ l.level }}{% endfor %}</div></div>
      </div>
    </section>
  </div>
</div>
<script>
  // Fit report for build.py: one A4 sheet, so report free space above the bottom margin.
  const mm = 96 / 25.4;
  const last = document.querySelector('.body').lastElementChild.getBoundingClientRect().bottom;
  const free = 297 * mm - 6 * mm - last;  // 6mm bottom margin
  document.body.dataset.fit = `${free < 0 ? 2 : 1}:${free.toFixed(0)}`;
</script>
</body>
</html>
